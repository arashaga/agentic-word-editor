# Microsoft Graph: public-client app, delegated Files.ReadWrite,
# Mobile and desktop redirect URI http://localhost. No client secret.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Existing Azure OpenAI resource and a structured-output-capable deployment.
# Agent chat also uses this deployment. Research additionally requires
# Azure Responses API + hosted web_search support; no Bing key/project is needed.
# Use the resource endpoint or /openai/v1/ base URL.
# Do not include /responses, /chat/completions, or /api/projects/<project>.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=

# entra: local DefaultAzureCredential (for example, az login).
# If key authentication is disabled, keep entra and leave the API key empty.
# key: explicitly use the server-side API key below instead.
AZURE_OPENAI_AUTH=entra
AZURE_OPENAI_API_KEY=
